FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY engine ./engine
COPY adapters ./adapters
COPY interfaces ./interfaces
COPY scripts ./scripts
COPY migrations ./migrations
COPY alembic.ini ./
COPY schemas ./schemas

RUN uv sync --frozen --no-dev

COPY packaging/windows/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONUNBUFFERED=1
ENV DDE_DATABASE_URL=postgresql+asyncpg://dde:dde@postgres:5432/dde
ENV DDE_REDIS_URL=redis://redis:6379/0
ENV DDE_OBJECT_STORE_ROOT=/var/dde/artifacts

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["serve"]
