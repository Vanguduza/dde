{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/frontend_chat_plan.json",
  "title": "FrontendChatPlan",
  "description": "DDE-069 durable conversational plan. A plan is a proposal until approved; step command execution remains a separate normal Gateway command identity.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "frontend_chat_plans",
    "order": 321,
    "pk": [
      "plan_id"
    ],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": true,
    "checks": [
      {
        "name": "frontend_chat_plans_state_known",
        "expression": "state IN ('DRAFT','READY','APPROVED','EXECUTING','PAUSED','COMPLETED','FAILED','CANCELLED')"
      }
    ],
    "foreign_keys": [
      {
        "name": "frontend_chat_plans_tenant_id_fkey",
        "columns": [
          "tenant_id"
        ],
        "ref_table": "tenants",
        "ref_columns": [
          "tenant_id"
        ]
      },
      {
        "name": "frontend_chat_plans_project_id_fkey",
        "columns": [
          "project_id"
        ],
        "ref_table": "projects",
        "ref_columns": [
          "project_id"
        ]
      },
      {
        "name": "frontend_chat_plans_mission_id_fkey",
        "columns": [
          "mission_id"
        ],
        "ref_table": "missions",
        "ref_columns": [
          "mission_id"
        ]
      },
      {
        "name": "frontend_chat_plans_conversation_id_fkey",
        "columns": [
          "conversation_id"
        ],
        "ref_table": "frontend_conversations",
        "ref_columns": [
          "conversation_id"
        ]
      },
      {
        "name": "frontend_chat_plans_workspace_id_fkey",
        "columns": [
          "workspace_id"
        ],
        "ref_table": "workspaces",
        "ref_columns": [
          "workspace_id"
        ]
      },
      {
        "name": "frontend_chat_plans_task_graph_id_fkey",
        "columns": [
          "task_graph_id"
        ],
        "ref_table": "task_graphs",
        "ref_columns": [
          "graph_id"
        ]
      },
      {
        "name": "frontend_chat_plans_created_from_turn_id_fkey",
        "columns": [
          "created_from_turn_id"
        ],
        "ref_table": "frontend_conversation_turns",
        "ref_columns": [
          "turn_id"
        ]
      },
      {
        "name": "frontend_chat_plans_approved_by_fkey",
        "columns": [
          "approved_by"
        ],
        "ref_table": "principals",
        "ref_columns": [
          "principal_id"
        ]
      }
    ]
  },
  "$defs": {
    "PlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "sequence",
        "title",
        "description",
        "state",
        "attempt",
        "parameters",
        "depends_on",
        "evidence_refs",
        "idempotency_key",
        "expected_request_hash"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "PENDING",
            "READY",
            "SUBMITTED",
            "COMPLETED",
            "FAILED",
            "BLOCKED",
            "SKIPPED",
            "CANCELLED"
          ]
        },
        "command_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_request_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "type": "integer"
        }
      }
    }
  },
  "required": [
    "plan_id",
    "tenant_id",
    "project_id",
    "mission_id",
    "conversation_id",
    "title",
    "objective",
    "state",
    "approval_required",
    "steps",
    "lock_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "APPROVED",
        "EXECUTING",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
