{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/context_activation_state.json",
  "title": "ContextActivationState",
  "description": "Chapter 5.13 durable context-policy mode per tenant/project (DDE-059). Owned by engine.context. The sole writers are ContextActivationService.attempt_advance (forward one step after gates) and ContextActivationService.rollback (return to last certified policy, never an untested arm). ContextService.compile() is the production reader: certified_baseline and shadow serve the Stage 1 pull policy with semantic retrieval off; canary applies the candidate arm on a limited hash-stable slice; promoted applies the candidate arm to all compiles. PARTIAL_PASS_IMPLEMENTED_GATES_ONLY never advances canary or promoted. One row per (tenant_id, project_id).",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "context_activation_state",
    "order": 136,
    "pk": ["activation_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [["tenant_id", "project_id"]],
    "checks": [
      {
        "name": "context_activation_state_mode",
        "expression": "context_mode IN ('certified_baseline', 'shadow', 'canary', 'promoted')"
      },
      {
        "name": "context_activation_state_certified_mode",
        "expression": "last_certified_mode IN ('certified_baseline', 'shadow', 'canary', 'promoted')"
      },
      {
        "name": "context_activation_state_candidate_arm",
        "expression": "candidate_arm IN ('pull', 'push', 'semantic')"
      },
      {
        "name": "context_activation_state_certified_arm",
        "expression": "last_certified_arm IN ('pull', 'push', 'semantic')"
      },
      {
        "name": "context_activation_state_canary_fraction",
        "expression": "canary_fraction >= 0 AND canary_fraction <= 1"
      }
    ],
    "foreign_keys": [
      {
        "name": "context_activation_state_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "context_activation_state_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "context_activation_state_last_promotion_run_id_fkey",
        "columns": ["last_promotion_run_id"],
        "ref_table": "promotion_gate_runs",
        "ref_columns": ["run_id"]
      }
    ]
  },
  "required": [
    "activation_id",
    "tenant_id",
    "project_id",
    "context_mode",
    "candidate_arm",
    "last_certified_mode",
    "last_certified_arm",
    "canary_fraction",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "activation_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "context_mode": {
      "type": "string",
      "enum": ["certified_baseline", "shadow", "canary", "promoted"]
    },
    "candidate_arm": {
      "type": "string",
      "enum": ["pull", "push", "semantic"]
    },
    "last_certified_mode": {
      "type": "string",
      "enum": ["certified_baseline", "shadow", "canary", "promoted"]
    },
    "last_certified_arm": {
      "type": "string",
      "enum": ["pull", "push", "semantic"]
    },
    "last_promotion_run_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "canary_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.05
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
