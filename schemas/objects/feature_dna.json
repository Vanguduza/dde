{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/feature_dna.json",
  "title": "FeatureDNA",
  "description": "Chapter 2.4 / 13.8 Feature DNA - canonical cross-cutting representation of a feature extracted from donor material (DDE-046/047). dna_hash content-addresses the body; taint_tags answer which donor evidence influenced this DNA (propagated further via donor_taints).",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "feature_dna",
    "order": 225,
    "pk": ["feature_dna_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [["project_id", "dna_hash"]],
    "foreign_keys": [
      {
        "name": "feature_dna_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "feature_dna_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "feature_dna_donor_artifact_id_fkey",
        "columns": ["donor_artifact_id"],
        "ref_table": "donor_artifacts",
        "ref_columns": ["donor_artifact_id"]
      }
    ]
  },
  "required": [
    "feature_dna_id",
    "tenant_id",
    "project_id",
    "donor_artifact_id",
    "title",
    "body",
    "donor_sources",
    "dna_hash",
    "taint_tags",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "feature_dna_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "donor_artifact_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "object", "additionalProperties": true },
    "donor_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dna_hash": { "type": "string", "minLength": 1 },
    "taint_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Chapter 13.8 provenance tags; mirrored onto donor_taints for tasks/diffs/evidence"
    },
    "status": {
      "type": "string",
      "enum": ["STUB", "COMPLETE"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
