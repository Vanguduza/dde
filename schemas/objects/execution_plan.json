    "status": { "type": "string" },
    "approved_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "started_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "ended_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
