      "type": "string",
      "enum": [
        "DISCOVERED",
        "EVIDENCE_QUALIFIED",
        "CONFLICT_CONFIRMED",
        "CHALLENGE_CANDIDATE",
        "REVIEW_REQUIRED",
        "MORE_EVIDENCE_REQUIRED",
        "ACCEPTED",
