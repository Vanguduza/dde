      "type": "object",
      "additionalProperties": true
    },
    "conflict": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence": {
      "type": "object",
      "additionalProperties": true
    },
    "impact": {
      "type": "object",
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "additionalProperties": true
    },
    "decision_analysis": {
      "type": "object",
      "additionalProperties": true
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
