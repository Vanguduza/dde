{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/credential_handle.json",
  "title": "CredentialHandle",
  "description": "Chapter 14.3's Credential Broker output -- the real record of a short-lived credential or scoped execution handle issued in exchange for a valid, currently-ACTIVE CapabilityLease. Owned by engine.capabilities.broker (Chapter 3.8: 'Credential handle | capabilities/broker | Credential Broker | Status only | Broker'). This row never carries the raw secret value: `secret_hash` is a SHA-256 digest only (Chapter 14.3: 'Audit records store metadata and hashes, never secret material'); the actual short-lived value is returned to the issuing caller exactly once, in process, and is never persisted anywhere. `renew()` never mutates an existing row's scope fields -- it mints a new handle referencing `supersedes_handle_id`, mirroring CapabilityDescriptor's own supersession pattern (Chapter 3.10: 'a material change creates a new version ... it never overwrites').",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "credential_handles",
    "order": 196,
    "pk": ["handle_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "foreign_keys": [
      {
        "name": "credential_handles_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "credential_handles_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "credential_handles_mission_id_fkey",
        "columns": ["mission_id"],
        "ref_table": "missions",
        "ref_columns": ["mission_id"]
      },
      {
        "name": "credential_handles_task_id_fkey",
        "columns": ["task_id"],
        "ref_table": "tasks",
        "ref_columns": ["task_id"]
      },
      {
        "name": "credential_handles_lease_id_fkey",
        "columns": ["lease_id"],
        "ref_table": "capability_leases",
        "ref_columns": ["lease_id"]
      },
      {
        "name": "credential_handles_supersedes_handle_id_fkey",
        "columns": ["supersedes_handle_id"],
        "ref_table": "credential_handles",
        "ref_columns": ["handle_id"]
      },
      {
        "name": "credential_handles_superseded_by_handle_id_fkey",
        "columns": ["superseded_by_handle_id"],
        "ref_table": "credential_handles",
        "ref_columns": ["handle_id"]
      }
    ]
  },
  "required": [
    "handle_id",
    "tenant_id",
    "project_id",
    "mission_id",
    "task_id",
    "lease_id",
    "capability_id",
    "provider_id",
    "resource_scope",
    "issued_by_policy_version",
    "secret_hash",
    "status",
    "issued_at",
    "expires_at",
    "requested_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "handle_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "mission_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "worker_run_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "lease_id": { "type": "string", "format": "uuid" },
    "capability_id": { "type": "string" },
    "provider_id": { "type": "string" },
    "provider_ref": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "resource_scope": { "type": "object", "additionalProperties": true },
    "issued_by_policy_version": { "type": "string" },
    "secret_hash": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ISSUED", "EXPIRED", "REVOKED", "SUPERSEDED"]
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "revocation_reason": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "supersedes_handle_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "superseded_by_handle_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "requested_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
