{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/frontend_contract.json",
  "title": "FrontendContract",
  "description": "DDE-069 declarative statement of what a project's frontend is obliged to contain, independent of what it currently renders. Owned by engine.studio.contract (FrontendContractService is the sole writer). This is the 'complete according to product intent' half of the pair whose other half is the Project Experience Graph ('what actually exists'); CoverageService compares them. Every obligation carries an explicit applicability, so an omission is always a recorded decision and never silence (FRONTEND_STUDIO_REV3 section 13.1: 'There is no silent omission state'). Immutable per version: a change publishes a new contract_version for the same project and supersedes the previous row, so a coverage snapshot can always be replayed against the exact contract it was computed from.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "frontend_contracts",
    "order": 300,
    "pk": [
      "contract_id"
    ],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [
      [
        "tenant_id",
        "project_id",
        "contract_version"
      ]
    ],
    "checks": [
      {
        "name": "frontend_contracts_version_positive",
        "expression": "contract_version >= 1"
      },
      {
        "name": "frontend_contracts_status_known",
        "expression": "status IN ('DRAFT', 'ACTIVE', 'SUPERSEDED')"
      }
    ],
    "foreign_keys": [
      {
        "name": "frontend_contracts_tenant_id_fkey",
        "columns": [
          "tenant_id"
        ],
        "ref_table": "tenants",
        "ref_columns": [
          "tenant_id"
        ]
      },
      {
        "name": "frontend_contracts_project_id_fkey",
        "columns": [
          "project_id"
        ],
        "ref_table": "projects",
        "ref_columns": [
          "project_id"
        ]
      },
      {
        "name": "frontend_contracts_mission_id_fkey",
        "columns": [
          "mission_id"
        ],
        "ref_table": "missions",
        "ref_columns": [
          "mission_id"
        ]
      }
    ]
  },
  "$defs": {
    "Obligation": {
      "type": "object",
      "additionalProperties": false,
      "description": "One thing the frontend must contain. `pxg_key` is the stable key CoverageService looks for in the Project Experience Graph; an obligation whose key resolves to no node is MISSING, not merely unverified.",
      "required": [
        "obligation_id",
        "dimension",
        "pxg_key",
        "statement",
        "applicability",
        "requirement_refs",
        "verification_kinds"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "format": "uuid"
        },
        "dimension": {
          "type": "string",
          "enum": [
            "screen",
            "journey",
            "component",
            "interaction",
            "state",
            "data_state",
            "responsive",
            "accessibility",
            "navigation",
            "verification"
          ]
        },
        "pxg_key": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicability": {
          "type": "string",
          "enum": [
            "REQUIRED",
            "OPTIONAL_SELECTED",
            "DEFERRED_APPROVED",
            "NOT_APPLICABLE_APPROVED",
            "BLOCKED_RECORDED"
          ]
        },
        "applicability_decision_ref": {
          "type": "string"
        },
        "verification_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "test",
              "db_assertion",
              "api_probe",
              "visual_diff",
              "silhouette",
              "visual_critique",
              "security_scan",
              "android_scan",
              "invariant",
              "judge",
              "human"
            ]
          }
        }
      }
    }
  },
  "required": [
    "contract_id",
    "tenant_id",
    "project_id",
    "contract_version",
    "content_hash",
    "status",
    "obligations",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "mission_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_version": {
      "type": "integer"
    },
    "content_hash": {
      "type": "string",
      "description": "sha256 over the obligation set only, so an identical contract republished is recognisably identical."
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUPERSEDED"
      ]
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Obligation"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
