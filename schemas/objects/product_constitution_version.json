{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/product_constitution_version.json",
  "title": "ProductConstitutionVersion",
  "description": "Versioned Product Constitution record. Changes only through change control.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "product_constitution_versions",
    "order": 50,
    "pk": ["version_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [["project_id", "version"]],
    "foreign_keys": [
      {
        "name": "product_constitution_versions_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "product_constitution_versions_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "product_constitution_versions_supersedes_id_fkey",
        "columns": ["supersedes_id"],
        "ref_table": "product_constitution_versions",
        "ref_columns": ["version_id"]
      }
    ]
  },
  "required": [
    "version_id",
    "tenant_id",
    "project_id",
    "version",
    "status",
    "body_markdown",
    "content_hash",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "active", "superseded"] },
    "body_markdown": { "type": "string" },
    "content_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "supersedes_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
