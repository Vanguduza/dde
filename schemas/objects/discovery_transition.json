{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/discovery_transition.json",
  "title": "DiscoveryTransition",
  "description": "Append-only EDR-0019 Epic C lifecycle history for one DiscoveryCandidate. Rows are immutable: deleting, reordering or rewriting a transition is a certification failure. sequence is dense and monotonic per candidate. A transition records the lifecycle movement only -- it can never carry a source_trust change, because trust is not earned by lifecycle progress.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "discovery_transitions",
    "order": 911,
    "pk": [
      "transition_id"
    ],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "foreign_keys": [
      {
        "name": "discovery_transitions_tenant_id_fkey",
        "columns": [
          "tenant_id"
        ],
        "ref_table": "tenants",
        "ref_columns": [
          "tenant_id"
        ]
      },
      {
        "name": "discovery_transitions_project_id_fkey",
        "columns": [
          "project_id"
        ],
        "ref_table": "projects",
        "ref_columns": [
          "project_id"
        ]
      },
      {
        "name": "discovery_transitions_candidate_id_fkey",
        "columns": [
          "candidate_id"
        ],
        "ref_table": "discovery_candidates",
        "ref_columns": [
          "candidate_id"
        ]
      }
    ],
    "uniques": [
      [
        "candidate_id",
        "sequence"
      ]
    ]
  },
  "required": [
    "transition_id",
    "tenant_id",
    "project_id",
    "candidate_id",
    "sequence",
    "to_state",
    "reason_code",
    "actor",
    "decision_hash",
    "occurred_at",
    "created_at"
  ],
  "properties": {
    "transition_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer"
    },
    "from_state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "DISCOVERED",
            "TRIAGED",
            "PROVENANCE_CHECKED",
            "CONTENT_ACQUIRED",
            "SANITIZED",
            "ARCHITECTURE_CHECKED",
            "TRIAL_ELIGIBLE",
            "SANDBOX_TESTED",
            "QUALIFIED",
            "ADMITTED",
            "REJECTED",
            "SUPERSEDED",
            "REVOKED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "to_state": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "TRIAGED",
        "PROVENANCE_CHECKED",
        "CONTENT_ACQUIRED",
        "SANITIZED",
        "ARCHITECTURE_CHECKED",
        "TRIAL_ELIGIBLE",
        "SANDBOX_TESTED",
        "QUALIFIED",
        "ADMITTED",
        "REJECTED",
        "SUPERSEDED",
        "REVOKED"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "enum": [
        "SYSTEM",
        "RESEARCH_MISSION",
        "OPERATOR",
        "VERIFIER",
        "POLICY"
      ]
    },
    "evidence_pointer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_hash": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
