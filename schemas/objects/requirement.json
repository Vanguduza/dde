{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/requirement.json",
  "title": "Requirement",
  "description": "Stable, testable statement of intended behaviour with constraints and acceptance conditions.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "requirements",
    "order": 60,
    "pk": ["requirement_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [["project_id", "slug"]],
    "foreign_keys": [
      {
        "name": "requirements_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "requirements_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "requirements_supersedes_id_fkey",
        "columns": ["supersedes_id"],
        "ref_table": "requirements",
        "ref_columns": ["requirement_id"]
      }
    ]
  },
  "required": [
    "requirement_id",
    "tenant_id",
    "project_id",
    "slug",
    "statement",
    "constraints",
    "acceptance_conditions",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "requirement_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "acceptance_conditions": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "retired", "superseded"]
    },
    "supersedes_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
