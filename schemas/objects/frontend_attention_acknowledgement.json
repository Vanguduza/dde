{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/frontend_attention_acknowledgement.json",
  "title": "FrontendAttentionAcknowledgement",
  "description": "DDE-069 durable project attention acknowledgement. It suppresses only the acknowledged derived attention fingerprint; it never resolves or mutates the underlying coverage/PXG/QA source.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "frontend_attention_acknowledgements",
    "order": 347,
    "pk": [
      "acknowledgement_id"
    ],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [
      [
        "project_id",
        "attention_key"
      ]
    ],
    "foreign_keys": [
      {
        "name": "frontend_attention_ack_tenant_fkey",
        "columns": [
          "tenant_id"
        ],
        "ref_table": "tenants",
        "ref_columns": [
          "tenant_id"
        ]
      },
      {
        "name": "frontend_attention_ack_project_fkey",
        "columns": [
          "project_id"
        ],
        "ref_table": "projects",
        "ref_columns": [
          "project_id"
        ]
      },
      {
        "name": "frontend_attention_ack_principal_fkey",
        "columns": [
          "acknowledged_by"
        ],
        "ref_table": "principals",
        "ref_columns": [
          "principal_id"
        ]
      }
    ]
  },
  "required": [
    "acknowledgement_id",
    "tenant_id",
    "project_id",
    "attention_key",
    "acknowledged_by",
    "acknowledged_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "acknowledgement_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "attention_key": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "acknowledged_by": {
      "type": "string",
      "format": "uuid"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
