{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/checkpoint.json",
  "title": "Checkpoint",
  "description": "Chapter 12.1 reconstructible continuation contract -- not a progress percentage and never the sole source of truth. Owned by engine.recovery (Chapter 3.6: checkpoints, effects, replay). tenant_id/project_id/mission_id are required by Chapter 3.2 even though 12.1's field sketch omits them. do_not_repeat is load-bearing: a resumed run must not re-execute those mutations. integrity_hash covers the reconstructible payload; a mismatched hash is not a valid checkpoint. Append-only: a later snapshot is a new row, not an update. worker_run_id is a real FK (checkpoint is recorded in the same unit of work as the run it snapshots, unlike ExternalEffect.prepare which commits before the run does). command_id is CommandLedger's identity at record() time (Chapter 12.5 / 12.6: every async command has a durable identity and idempotency key).",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "checkpoints",
    "order": 198,
    "pk": ["checkpoint_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "foreign_keys": [
      {
        "name": "checkpoints_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "checkpoints_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "checkpoints_mission_id_fkey",
        "columns": ["mission_id"],
        "ref_table": "missions",
        "ref_columns": ["mission_id"]
      },
      {
        "name": "checkpoints_task_id_fkey",
        "columns": ["task_id"],
        "ref_table": "tasks",
        "ref_columns": ["task_id"]
      },
      {
        "name": "checkpoints_task_attempt_id_fkey",
        "columns": ["task_attempt_id"],
        "ref_table": "task_attempts",
        "ref_columns": ["attempt_id"]
      },
      {
        "name": "checkpoints_worker_run_id_fkey",
        "columns": ["worker_run_id"],
        "ref_table": "worker_runs",
        "ref_columns": ["run_id"]
      },
      {
        "name": "checkpoints_context_package_id_fkey",
        "columns": ["context_package_id"],
        "ref_table": "context_packages",
        "ref_columns": ["package_id"]
      },
      {
        "name": "checkpoints_execution_plan_id_fkey",
        "columns": ["execution_plan_id"],
        "ref_table": "execution_plans",
        "ref_columns": ["plan_id"]
      },
      {
        "name": "checkpoints_command_id_fkey",
        "columns": ["command_id"],
        "ref_table": "command_idempotency",
        "ref_columns": ["command_id"]
      }
    ]
  },
  "required": [
    "checkpoint_id",
    "tenant_id",
    "project_id",
    "mission_id",
    "task_id",
    "task_attempt_id",
    "worker_run_id",
    "context_package_id",
    "execution_plan_id",
    "completed_work",
    "verified_work",
    "pending_work",
    "known_failures",
    "next_action",
    "do_not_repeat",
    "artifact_refs",
    "lease_refs",
    "workspace_revision",
    "integration_state",
    "event_sequence",
    "integrity_hash",
    "command_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "checkpoint_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "mission_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "task_attempt_id": { "type": "string", "format": "uuid" },
    "worker_run_id": { "type": "string", "format": "uuid" },
    "context_package_id": { "type": "string", "format": "uuid" },
    "execution_plan_id": { "type": "string", "format": "uuid" },
    "completed_work": { "type": "array", "items": { "type": "string" } },
    "verified_work": { "type": "array", "items": { "type": "string" } },
    "pending_work": { "type": "array", "items": { "type": "string" } },
    "known_failures": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "do_not_repeat": { "type": "array", "items": { "type": "string" } },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "lease_refs": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "workspace_revision": { "type": "string" },
    "integration_state": { "type": "string" },
    "event_sequence": { "type": "integer" },
    "integrity_hash": { "type": "string" },
    "command_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
