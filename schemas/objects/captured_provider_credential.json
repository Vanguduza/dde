{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/captured_provider_credential.json",
  "title": "CapturedProviderCredential",
  "description": "Chapter 14.3 static-secret capture metadata -- durable, non-secret record of an operator-pasted provider credential (e.g. OpenSandbox API key) admitted through the Credential Broker seam. Owned by engine.capabilities.broker. This row NEVER carries the raw secret: only secret_hash (SHA-256), last4, and fingerprint for audit/UI confirmation. Raw material lives exclusively in the broker-private static vault table (not this contract). A material re-capture supersedes the prior CAPTURED row (status SUPERSEDED) rather than mutating it.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "captured_provider_credentials",
    "order": 226,
    "pk": ["capture_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "foreign_keys": [
      {
        "name": "captured_provider_credentials_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "captured_provider_credentials_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "captured_provider_credentials_supersedes_capture_id_fkey",
        "columns": ["supersedes_capture_id"],
        "ref_table": "captured_provider_credentials",
        "ref_columns": ["capture_id"]
      },
      {
        "name": "captured_provider_credentials_superseded_by_capture_id_fkey",
        "columns": ["superseded_by_capture_id"],
        "ref_table": "captured_provider_credentials",
        "ref_columns": ["capture_id"]
      }
    ]
  },
  "required": [
    "capture_id",
    "tenant_id",
    "project_id",
    "provider_id",
    "secret_hash",
    "fingerprint",
    "last4",
    "status",
    "captured_by",
    "captured_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "capture_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "provider_id": { "type": "string", "minLength": 1 },
    "domain": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "secret_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "fingerprint": { "type": "string", "minLength": 1 },
    "last4": { "type": "string", "minLength": 4, "maxLength": 4 },
    "status": {
      "type": "string",
      "enum": ["CAPTURED", "REVOKED", "SUPERSEDED"]
    },
    "supersedes_capture_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "superseded_by_capture_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "captured_by": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "revoked_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
