{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://dde.dev/schemas/objects/bounded_loop_definition.json", "title": "BoundedLoopDefinition", "description": "Verifier-terminated bounded convergence loop. Uncertain side effects cannot be blindly retried.", "type": "object", "additionalProperties": false,
