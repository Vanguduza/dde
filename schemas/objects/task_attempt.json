{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/task_attempt.json",
  "title": "TaskAttempt",
  "description": "Durable attempt (Chapter 12.2). WorkerRun is 1:N via worker_runs.task_attempt_id. Result, artifact refs and state are committed on the same row (Attempt commit); a retry is a new row (retry_of), which is what Chapter 3.8's Append-only note means. status is IN_PROGRESS | COMPLETED | FAILED. COMPLETED is written only after verification (Chapter 3.9 step 15). A COMPLETED attempt is never re-run because a later task failed.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "task_attempts",
    "order": 170,
    "pk": ["attempt_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [
      ["task_id", "sequence"],
      ["attempt_id", "project_id", "tenant_id"]
    ],
    "foreign_keys": [
      {
        "name": "task_attempts_mission_scope_fkey",
        "columns": ["mission_id", "project_id", "tenant_id"],
        "ref_table": "missions",
        "ref_columns": ["mission_id", "project_id", "tenant_id"]
      },
      {
        "name": "task_attempts_task_scope_fkey",
        "columns": ["task_id", "project_id", "tenant_id"],
        "ref_table": "tasks",
        "ref_columns": ["task_id", "project_id", "tenant_id"]
      },
      {
        "name": "task_attempts_execution_plan_id_fkey",
        "columns": ["execution_plan_id"],
        "ref_table": "execution_plans",
        "ref_columns": ["plan_id"]
      },
      {
        "name": "task_attempts_retry_of_fkey",
        "columns": ["retry_of"],
        "ref_table": "task_attempts",
        "ref_columns": ["attempt_id"]
      }
    ]
  },
  "required": [
    "attempt_id",
    "tenant_id",
    "project_id",
    "mission_id",
    "task_id",
    "sequence",
    "execution_plan_id",
    "input_context_hash",
    "workspace_revision",
    "result_artifact_refs",
    "verification_refs",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "attempt_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "mission_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer" },
    "execution_plan_id": { "type": "string", "format": "uuid" },
    "input_context_hash": { "type": "string" },
    "workspace_revision": { "type": "string" },
    "result_artifact_refs": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "verification_refs": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "integration_proposal_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "COMPLETED", "FAILED"]
    },
    "failure_class": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "retry_of": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "checkpoint_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "started_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "ended_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
