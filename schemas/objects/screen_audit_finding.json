      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "pxg_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "node_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "finding_type": {
      "type": "string"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "CONTRACT",
        "JOURNEY",
        "FUNCTIONAL",
        "STATE",
        "DATA",
        "ROLE",
        "PERMISSION",
        "NAVIGATION",
        "ACCESSIBILITY",
        "RESPONSIVE_PLATFORM",
        "VISUAL",
        "SOURCE_PROVENANCE",
        "SECURITY",
        "VERIFICATION",
        "DRIFT"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "BLOCKING",
        "ERROR",
        "WARNING",
        "INFO"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DETECTED",
        "CONFIRMED",
        "CANDIDATE_CREATED",
        "ASSIGNED",
        "VERIFYING",
        "RESOLVED",
        "ACCEPTED_EXCEPTION",
        "BLOCKED",
        "SUPERSEDED"
      ]
    },
    "assessment_state": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "UNKNOWN",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
