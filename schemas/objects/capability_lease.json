{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/capability_lease.json",
  "title": "CapabilityLease",
  "description": "Chapter 9.2's CapabilityLease -- the real authority boundary deciding whether a caller may invoke a capability at all (distinct from Chapter 10.3's WriteScopeLease, which governs which paths an already-authorized operation may touch). Owned by engine.capabilities (Chapter 3.8: 'Lease manager'). Chapter 3.8: 'Status only; scope immutable' -- every field but status/denied_reason/revoked_at/revocation_reason/updated_at is fixed at request time, matching Chapter 3.9 step 11 ('CapabilityLeases issued, bound to the run') issuing a lease only once a WorkerRun already exists.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "capability_leases",
    "order": 195,
    "pk": ["lease_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "foreign_keys": [
      {
        "name": "capability_leases_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "capability_leases_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "capability_leases_mission_id_fkey",
        "columns": ["mission_id"],
        "ref_table": "missions",
        "ref_columns": ["mission_id"]
      },
      {
        "name": "capability_leases_task_id_fkey",
        "columns": ["task_id"],
        "ref_table": "tasks",
        "ref_columns": ["task_id"]
      },
      {
        "name": "capability_leases_execution_plan_id_fkey",
        "columns": ["execution_plan_id"],
        "ref_table": "execution_plans",
        "ref_columns": ["plan_id"]
      }
    ]
  },
  "required": [
    "lease_id",
    "tenant_id",
    "project_id",
    "mission_id",
    "task_id",
    "execution_plan_id",
    "capability_id",
    "capability_version",
    "resource_scope",
    "operation_scope",
    "constraints",
    "issued_by_policy_version",
    "issued_at",
    "expires_at",
    "revocable",
    "status",
    "lease_hash",
    "requested_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "lease_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "mission_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "execution_plan_id": { "type": "string", "format": "uuid" },
    "worker_run_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "environment_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "capability_id": { "type": "string" },
    "capability_version": { "type": "string" },
    "resource_scope": { "type": "object", "additionalProperties": true },
    "operation_scope": { "type": "string" },
    "constraints": { "type": "object", "additionalProperties": true },
    "issued_by_policy_version": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revocable": { "type": "boolean" },
    "status": { "type": "string" },
    "denied_reason": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "revoked_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "revocation_reason": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "lease_hash": { "type": "string" },
    "requested_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
