{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/routing_decision_outcome.json",
  "title": "RoutingDecisionOutcome",
  "description": "Chapter 6.5 real telemetry: 'Even under deterministic routing, DDE records for every decision ... actual verified outcome, verification confidence, rework count, escalation, human intervention, actual token/tool cost, elapsed time, failure class, recovery path, context policy version, capability set, and the attribution from Sec5.11.' Decision-time fields (candidate set, predictions, selection_propensity) are already durable on the RouteDecision this row references via `route_decision_id`; this table stores only the outcome-side signals a RouteDecision cannot know about itself, joined back to it. `disclosed_gaps` names Chapter 6.5 fields this Stage 1 slice cannot populate from a real signal yet (actual token/tool cost has no UsageRecord writer in this codebase), never silently defaulted. Owned by engine.telemetry (Chapter 3.8).",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "routing_decision_outcomes",
    "order": 131,
    "pk": ["outcome_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "uniques": [["verification_run_id"]],
    "foreign_keys": [
      {
        "name": "routing_decision_outcomes_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "routing_decision_outcomes_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "routing_decision_outcomes_route_decision_id_fkey",
        "columns": ["route_decision_id"],
        "ref_table": "route_decisions",
        "ref_columns": ["decision_id"]
      },
      {
        "name": "routing_decision_outcomes_verification_run_id_fkey",
        "columns": ["verification_run_id"],
        "ref_table": "verification_runs",
        "ref_columns": ["verification_run_id"]
      },
      {
        "name": "routing_decision_outcomes_failure_attribution_id_fkey",
        "columns": ["failure_attribution_id"],
        "ref_table": "failure_attributions",
        "ref_columns": ["attribution_id"]
      }
    ]
  },
  "required": [
    "outcome_id",
    "tenant_id",
    "project_id",
    "mission_id",
    "task_id",
    "route_decision_id",
    "task_attempt_id",
    "verification_run_id",
    "actual_verified_outcome",
    "verification_confidence",
    "rework_count",
    "escalated",
    "human_intervention_required",
    "context_package_id",
    "capability_set",
    "disclosed_gaps",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "outcome_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "mission_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "route_decision_id": { "type": "string", "format": "uuid" },
    "task_attempt_id": { "type": "string", "format": "uuid" },
    "verification_run_id": { "type": "string", "format": "uuid" },
    "actual_verified_outcome": { "type": "string", "enum": ["PASSED", "FAILED"] },
    "verification_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rework_count": { "type": "integer", "minimum": 0 },
    "escalated": { "type": "boolean" },
    "human_intervention_required": { "type": "boolean" },
    "recovery_action": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "failure_class": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "elapsed_seconds": {
      "anyOf": [{ "type": "number" }, { "type": "null" }]
    },
    "context_package_id": { "type": "string", "format": "uuid" },
    "capability_set": { "type": "array", "items": { "type": "string" } },
    "failure_attribution_id": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "disclosed_gaps": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
