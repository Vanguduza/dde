      "format": "uuid"
    },
    "unit_map_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "concern": {
      "type": "string"
    },
    "source_id": {
