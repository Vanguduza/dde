{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/vekl_research_finding.json",
  "title": "VEKLResearchFinding",
  "description": "Typed source-admitted research result. Findings are evidence/candidate intelligence and never Project Truth.",
