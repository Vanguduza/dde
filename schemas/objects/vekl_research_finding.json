        "ref_columns": [
          "resource_id"
        ]
      }
    ],
    "indexes": [
      {
        "name": "ix_vekl_research_findings_unit_class",
        "columns": [
          "project_id",
          "unit_map_id",
          "classification"
        ]
      }
    ]
  },
  "required": [
