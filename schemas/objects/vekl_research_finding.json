      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stack_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact_hypothesis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
