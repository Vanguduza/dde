{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/project.json",
  "title": "Project",
  "description": "Project identity scoped to a tenant.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "projects",
    "order": 20,
    "pk": ["project_id"],
    "tenant_scoped": true,
    "project_scoped": false,
    "lock_version": false,
    "uniques": [["tenant_id", "slug"]],
    "foreign_keys": [
      {
        "name": "projects_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      }
    ]
  },
  "required": ["project_id", "tenant_id", "slug", "created_at", "updated_at"],
  "properties": {
    "project_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
