{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/vekl_knowledge_node.json",
  "title": "VEKLKnowledgeNode",
  "description": "Rebuildable typed graph node referencing an existing DDE authority or an explicitly derived projection.",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "vekl_knowledge_nodes",
    "order": 357,
    "pk": [
      "knowledge_node_id"
    ],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "foreign_keys": [
      {
        "name": "vekl_knowledge_node_tenant_fkey",
        "columns": [
          "tenant_id"
        ],
        "ref_table": "tenants",
        "ref_columns": [
          "tenant_id"
        ]
      },
      {
        "name": "vekl_knowledge_node_project_fkey",
        "columns": [
          "project_id"
        ],
        "ref_table": "projects",
        "ref_columns": [
          "project_id"
        ]
      }
    ],
    "uniques": [
      [
        "project_id",
        "node_kind",
        "stable_ref",
        "content_hash",
        "projection_compiler_version"
      ]
    ],
    "indexes": [
      {
        "name": "ix_vekl_knowledge_nodes_active_ref",
        "columns": [
          "project_id",
          "node_kind",
          "stable_ref"
        ],
        "where": "invalidated_at IS NULL"
      }
    ]
  },
  "required": [
    "knowledge_node_id",
    "tenant_id",
    "project_id",
    "node_kind",
    "object_type",
    "stable_ref",
    "authority_class",
    "authority_service",
    "content_hash",
    "projection_compiler_version",
    "metadata",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "knowledge_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_kind": {
      "type": "string",
      "enum": [
        "TARGET_PROJECT",
        "PRODUCT_CONSTITUTION",
        "REQUIREMENT",
        "EDR",
        "MISSION",
        "TASK_GRAPH",
        "TASK",
        "DEVELOPMENT_UNIT_PROJECTION",
        "STACK_FINGERPRINT",
        "TASK_SIGNATURE",
        "WORKSPACE",
        "CHANGE_PACKET",
        "CONTRACT",
        "API",
        "EVENT",
        "SCHEMA",
        "CODE_MODULE",
        "PACKAGE",
        "DEPLOYMENT_TARGET",
        "PXG_NODE",
        "FRONTEND_CONTRACT_OBLIGATION",
        "SCREEN",
        "USER_JOURNEY",
        "DESIGN_AUTHORITY",
        "SECURITY_CONTROL",
        "RECOVERY_PATTERN",
        "KNOWLEDGE_CONCERN",
        "VEKL_RESOURCE",
        "SOURCE",
        "SOURCE_ARTIFACT",
        "VEKL_ACTIVATION_MANIFEST",
        "CONTEXT_PACKAGE",
        "KNOWLEDGE_RESOLUTION_TRACE",
        "ACCEPTANCE_ORACLE",
        "VERIFICATION_RUN",
        "VERIFICATION_RESULT_REF",
        "EVIDENCE",
        "RESEARCH_FINDING",
        "TRUTH_CHALLENGE",
        "APPROVAL"
      ]
    },
    "object_type": {
      "type": "string"
    },
    "object_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "stable_ref": {
      "type": "string"
    },
    "authority_class": {
      "type": "string"
    },
    "authority_service": {
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "type": "string"
    },
    "projection_compiler_version": {
      "type": "string"
    },
    "project_truth_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
