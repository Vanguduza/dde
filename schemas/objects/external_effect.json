{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/objects/external_effect.json",
  "title": "ExternalEffect",
    "description": "Chapter 12.4's external effect journal -- the durable record of one real, lease-gated side effect a Capability adapter performs on behalf of a WorkerRun. Owned by engine.recovery (Chapter 3.8). engine.recovery is the sole writer; production mutation call sites are ScriptedWorkerAdapter (run_local_process) and IntegrationQueueService.submit (git update-ref). WorkspaceService.snapshot may journal a git read as optional extra audit, which is not the Chapter 12.4 mutation proof. prepare() refuses a new mutation of the same logical scope (mission + target_system + target_resource + operation) while SENT/UNKNOWN/RECONCILING or verified-present RECONCILED rows exist -- a new WorkerRun/idempotency_key does not bypass that recovery rule. Idempotency_key/request_hash (Chapter 12.5) are established through CommandLedger at prepare() time. status never regresses: PREPARED -> SENT -> CONFIRMED | FAILED | (UNKNOWN -> RECONCILING -> RECONCILED). Only a verified absence permits a new mutation attempt; verified presence sets confirmed_at. IRREVERSIBLE reconciliation failure raises EFFECT_IRREVERSIBLE and emits ExternalEffectIrreversibleEscalated. worker_run_id is a soft reference, not a foreign key (prepare/mark_sent commit before the side effect, while invoke_run may still hold the WorkerRun insert uncommitted).",
  "type": "object",
  "additionalProperties": false,
  "x-dde-storage": {
    "table": "external_effects",
    "order": 197,
    "pk": ["effect_id"],
    "tenant_scoped": true,
    "project_scoped": true,
    "lock_version": false,
    "foreign_keys": [
      {
        "name": "external_effects_tenant_id_fkey",
        "columns": ["tenant_id"],
        "ref_table": "tenants",
        "ref_columns": ["tenant_id"]
      },
      {
        "name": "external_effects_project_id_fkey",
        "columns": ["project_id"],
        "ref_table": "projects",
        "ref_columns": ["project_id"]
      },
      {
        "name": "external_effects_mission_id_fkey",
        "columns": ["mission_id"],
        "ref_table": "missions",
        "ref_columns": ["mission_id"]
      },
      {
        "name": "external_effects_capability_lease_id_fkey",
        "columns": ["capability_lease_id"],
        "ref_table": "capability_leases",
        "ref_columns": ["lease_id"]
      },
      {
        "name": "external_effects_command_id_fkey",
        "columns": ["command_id"],
        "ref_table": "command_idempotency",
        "ref_columns": ["command_id"]
      }
    ]
  },
  "required": [
    "effect_id",
    "tenant_id",
    "project_id",
    "mission_id",
    "worker_run_id",
    "capability_lease_id",
    "command_id",
    "target_system",
    "target_resource",
    "operation",
    "side_effect_class",
    "idempotency_key",
    "request_hash",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "effect_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "mission_id": { "type": "string", "format": "uuid" },
    "worker_run_id": { "type": "string", "format": "uuid" },
    "capability_lease_id": { "type": "string", "format": "uuid" },
    "command_id": { "type": "string", "format": "uuid" },
    "target_system": { "type": "string" },
    "target_resource": { "type": "string" },
    "operation": { "type": "string" },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "PURE_READ",
        "WORKSPACE_LOCAL",
        "EXTERNAL_IDEMPOTENT",
        "EXTERNAL_NON_IDEMPOTENT",
        "IRREVERSIBLE"
      ]
    },
    "idempotency_key": { "type": "string" },
    "request_hash": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "PREPARED",
        "SENT",
        "CONFIRMED",
        "FAILED",
        "UNKNOWN",
        "RECONCILING",
        "RECONCILED"
      ]
    },
    "external_reference": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "response_hash": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "reconciliation_method": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "confirmed_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
