{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dde.dev/schemas/design/tokens.json",
  "title": "DdeDesignTokens",
  "description": "Frontend/UX playbook guardrail 4.2: single source of truth for every visual value a DDE surface may use. Every leaf pins its value with 'const' -- the sheet is simultaneously the definition and the validator of any claimed token set. Codegen (scripts/generate_design_tokens.py) emits typed constants plus the CSS :root block consumed by dde-studio; hand edits to generated output fail drift checks. Semantic aliases are what components reference; raw palette entries exist only so aliases can resolve.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "color",
    "spacing",
    "radius",
    "shadow",
    "typography",
    "motion",
    "zIndex"
  ],
  "properties": {
    "version": { "const": 1 },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "semantic"],
      "properties": {
        "palette": {
          "type": "object",
          "description": "Raw color values. Referenced by semantic aliases, never by components.",
          "additionalProperties": false,
          "required": [
            "bg",
            "card",
            "fg",
            "muted",
            "border",
            "accent",
            "accentFg",
            "focus",
            "ok",
            "warn",
            "err"
          ],
          "properties": {
            "bg": { "const": "#1e1e1e" },
            "card": { "const": "#252526" },
            "fg": { "const": "#e6e6e6" },
            "muted": { "const": "#b0b0b0" },
            "border": { "const": "rgba(200,200,200,0.28)" },
            "accent": { "const": "#1177bb" },
            "accentBright": { "const": "#6cb6ff" },
            "accentFg": { "const": "#ffffff" },
            "focus": { "const": "#4fc1ff" },
            "ok": { "const": "#3fb950" },
            "warn": { "const": "#e3b341" },
            "err": { "const": "#f85149" },
            "borderHover": { "const": "rgba(200,200,200,0.45)" },
            "hoverWash": { "const": "rgba(255,255,255,0.04)" },
            "okBorder": { "const": "rgba(63,185,80,0.4)" },
            "okWash": { "const": "rgba(63,185,80,0.1)" },
            "warnBorder": { "const": "rgba(227,179,65,0.4)" },
            "warnWash": { "const": "rgba(227,179,65,0.08)" },
            "errBorder": { "const": "rgba(248,81,73,0.4)" },
            "errWash": { "const": "rgba(248,81,73,0.08)" },
            "insetWash": { "const": "rgba(0,0,0,0.15)" }
          }
        },
        "semantic": {
          "type": "object",
          "description": "Role names components reference. Values are CSS custom-property names over the palette.",
          "additionalProperties": false,
          "required": [
            "surfaceBase",
            "surfaceCard",
            "textPrimary",
            "textMuted",
            "borderDefault",
            "accentPrimary",
            "accentBrightText",
            "borderHoverLine",
            "hoverWashBg",
            "okBorderLine",
            "okWashBg",
            "warnBorderLine",
            "warnWashBg",
            "errBorderLine",
            "errWashBg",
            "insetWashBg",
            "accentOnAccent",
            "statusOk",
            "statusWarn",
            "statusErr",
            "focusRing"
          ],
          "properties": {
            "surfaceBase": { "const": "--bg" },
            "surfaceCard": { "const": "--card" },
            "textPrimary": { "const": "--fg" },
            "textMuted": { "const": "--muted" },
            "borderDefault": { "const": "--border" },
            "accentPrimary": { "const": "--accent" },
            "accentBrightText": { "const": "--accent-bright" },
            "borderHoverLine": { "const": "--border-hover" },
            "hoverWashBg": { "const": "--hover-wash" },
            "okBorderLine": { "const": "--ok-border" },
            "okWashBg": { "const": "--ok-wash" },
            "warnBorderLine": { "const": "--warn-border" },
            "warnWashBg": { "const": "--warn-wash" },
            "errBorderLine": { "const": "--err-border" },
            "errWashBg": { "const": "--err-wash" },
            "insetWashBg": { "const": "--inset-wash" },
            "accentOnAccent": { "const": "--accent-fg" },
            "statusOk": { "const": "--ok" },
            "statusWarn": { "const": "--warn" },
            "statusErr": { "const": "--err" },
            "focusRing": { "const": "--focus" }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "description": "4px-base scale. Off-scale paddings/margins/gaps fail the design lint.",
      "required": [
        "space0",
        "space1",
        "space2",
        "space3",
        "space4",
        "space5",
        "space6",
        "space7",
        "space8"
      ],
      "properties": {
        "space0": { "const": 0 },
        "space1": { "const": 4 },
        "space2": { "const": 8 },
        "space3": { "const": 12 },
        "space4": { "const": 16 },
        "space5": { "const": 20 },
        "space6": { "const": 24 },
        "space7": { "const": 32 },
        "space8": { "const": 40 }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sm", "md", "lg", "pill"],
      "properties": {
        "sm": { "const": 3 },
        "md": { "const": 4 },
        "lg": { "const": 6 },
        "pill": { "const": 999 }
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "description": "Single allowed elevation shadow; layered blur chrome (glassmorphism) is banned.",
      "required": ["overlay"],
      "properties": {
        "overlay": { "const": "0 1px 3px rgba(0,0,0,0.35)" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamilyBody", "fontFamilyMono", "scale"],
      "properties": {
        "fontFamilyBody": { "const": "\"Segoe UI\", system-ui, sans-serif" },
        "fontFamilyMono": { "const": "Consolas, \"Courier New\", monospace" },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "description": "rem type scale. Only these sizes may appear in UI code.",
          "required": ["xs", "sm", "body", "md", "lg"],
          "properties": {
            "xs": { "const": 0.68 },
            "sm": { "const": 0.75 },
            "body": { "const": 0.85 },
            "md": { "const": 1.0 },
            "lg": { "const": 1.15 }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "easing"],
      "properties": {
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "description": "Playbook 5.2: durations only from this scale; loops longer than one bounded cycle (<=2000ms) are banned.",
          "required": ["fast", "base", "slow"],
          "properties": {
            "fast": { "const": 120 },
            "base": { "const": 180 },
            "slow": { "const": 240 }
          }
        },
        "easing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Playbook 5.2: three easings maximum -- ease-out arrival, symmetric state-change ease, linear progress. Springs/bounce/overshoot banned.",
          "required": ["arrival", "state", "linear"],
          "properties": {
            "arrival": { "const": "cubic-bezier(0.16, 1, 0.3, 1)" },
            "state": { "const": "cubic-bezier(0.4, 0, 0.2, 1)" },
            "linear": { "const": "linear" }
          }
        }
      }
    },
    "zIndex": {
      "type": "object",
      "additionalProperties": false,
      "description": "Layer ladder: content < sticky chrome < skip link < overlay/dialog < toast.",
      "required": ["content", "sticky", "skipLink", "overlay", "toast"],
      "properties": {
        "content": { "const": 0 },
        "sticky": { "const": 10 },
        "skipLink": { "const": 100 },
        "overlay": { "const": 500 },
        "toast": { "const": 600 }
      }
    }
  }
}
