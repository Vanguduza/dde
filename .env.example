DDE_DATABASE_URL=postgresql+asyncpg://dde:dde@postgres:5432/dde
DDE_REDIS_URL=redis://redis:6379/0

# Cursor worker adapter (adapters/cursor). Never inject this into a WorkerRun environment.
# Mint at https://cursor.com/dashboard/api (user key) or team service accounts.
DDE_CURSOR_API_KEY=
DDE_CURSOR_DEFAULT_MODEL=composer-2.5

# OpenSandbox (adapters/opensandbox) — headless fallback only.
# Preferred UX: DDE Studio Settings → paste API key (+ domain) → Credential Broker
# capture (hash + fingerprint; raw key never stored in Studio or Gateway responses).
# DDE_OPENSANDBOX_API_KEY / OPEN_SANDBOX_API_KEY are read only when no captured
# credential is available for the project.
# DDE_OPENSANDBOX_ENABLED=false
# DDE_OPENSANDBOX_DOMAIN=
# DDE_OPENSANDBOX_API_KEY=
# DDE_OPENSANDBOX_PROTOCOL=http
# DDE_OPENSANDBOX_DEFAULT_IMAGE=ubuntu

